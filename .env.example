# ---------------------------------------------------------------
# Supabase (Project Settings > API)
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# SOMENTE SERVIDOR. Ignora RLS: nunca exponha no navegador
# (não use o prefixo NEXT_PUBLIC_). Usada pelo worker, Storage e cron.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# ---------------------------------------------------------------
# URL intermediária gravada no QR e no NFC de cada placa.
# Produção: domínio dedicado apontando para este mesmo projeto na Vercel.
#   NEXT_PUBLIC_GO_BASE_URL=https://go.meudominio.com
# Desenvolvimento local:
#   NEXT_PUBLIC_GO_BASE_URL=http://localhost:3000/go
#
# ATENÇÃO: faz parte da identidade física das placas. Depois que houver
# placas impressas ou NFC gravados, NUNCA altere este valor.
# ---------------------------------------------------------------
NEXT_PUBLIC_GO_BASE_URL=http://localhost:3000/go

# ---------------------------------------------------------------
# Opcional: protege GET /api/cron/exports (Authorization: Bearer <valor>).
# Gere com: openssl rand -hex 32
# ---------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------
# Limites opcionais (os padrões estão entre parênteses)
# ---------------------------------------------------------------
# Tamanho máximo da arte base, em MB (25). Mantenha igual ao limite do bucket plate-templates.
# TEMPLATE_MAX_UPLOAD_MB=25
# Largura/altura máxima da arte, em px (8000)
# TEMPLATE_MAX_DIMENSION=8000
# Total máximo de pixels da arte (50000000)
# TEMPLATE_MAX_PIXELS=50000000
# Tamanho máximo de cada parte de ZIP, em MB (45). Plano gratuito do Supabase: arquivos até 50 MB.
# EXPORT_PART_MAX_MB=45
# Orçamento de tempo de cada execução do worker, em ms (45000). Mantenha abaixo do maxDuration (60 s).
# EXPORT_TIME_BUDGET_MS=45000
# Tempo máximo para montar uma parte de ZIP, em ms (30000)
# EXPORT_PART_TIME_LIMIT_MS=30000

# ---------------------------------------------------------------
# DirectLab · Avaliação Google (Google Places API (New))
# SOMENTE SERVIDOR: nunca use o prefixo NEXT_PUBLIC_. A chave não é enviada
# ao navegador nem devolvida pela API. Sem ela, o DirectLab mostra
# "não configurado" e o resto do sistema funciona normalmente.
# No Google Cloud: habilite "Places API (New)" e restrinja a chave a essa API.
# ---------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
